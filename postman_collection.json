{
  "info": {
    "name": "Live Video Streaming Service API",
    "description": "API for video streaming with MinIO storage, Cloudinary CDN, M-Pesa payments, and channel subscriptions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8040/api/v1"
    },
    {
      "key": "host",
      "value": "http://localhost:8040"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google OAuth Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/google",
              "host": ["{{baseUrl}}"],
              "path": ["users", "google"]
            },
            "description": "Redirects to Google OAuth login page"
          }
        },
        {
          "name": "Google OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/google/callback",
              "host": ["{{baseUrl}}"],
              "path": ["users", "google", "callback"]
            },
            "description": "Google OAuth callback - returns JWT tokens (accessToken, refreshToken)"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"username\": \"newusername\",\n  \"phoneNumber\": \"254712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile/update",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile", "update"]
            },
            "description": "Update user profile (queued via RabbitMQ). Returns 202 Accepted."
          }
        }
      ]
    },
    {
      "name": "Channels",
      "description": "Channel management - create, update, delete channels. Channels can be free or paid.",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "Get All Channels",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels"]
                },
                "description": "Get all channels"
              }
            },
            {
              "name": "Search Channels",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/search?q=gaming",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", "search"],
                  "query": [
                    { "key": "q", "value": "gaming" }
                  ]
                },
                "description": "Search channels by name"
              }
            },
            {
              "name": "Get Trending Channels",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/trending?limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", "trending"],
                  "query": [
                    { "key": "limit", "value": "10" }
                  ]
                },
                "description": "Get trending channels based on recent subscriber growth"
              }
            },
            {
              "name": "Get Channel by ID",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", ":id"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Get channel details including isPaid, subscriptionPrice, currency"
              }
            },
            {
              "name": "Get Channel Videos",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/:id/videos",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", ":id", "videos"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Get all videos from a channel"
              }
            },
            {
              "name": "Get Channel Stats",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/:id/stats",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", ":id", "stats"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Get channel statistics (subscriber count, video count, total duration)"
              }
            }
          ]
        },
        {
          "name": "Authenticated",
          "item": [
            {
              "name": "Create Channel",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"My Awesome Channel\",\n  \"description\": \"Channel description here\",\n  \"isPaid\": false,\n  \"subscriptionPrice\": null,\n  \"currency\": \"KES\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/channels",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels"]
                },
                "description": "Create a new channel. Set isPaid=true and subscriptionPrice for paid channels."
              }
            },
            {
              "name": "Create Paid Channel",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Premium Gaming Channel\",\n  \"description\": \"Exclusive gaming content\",\n  \"isPaid\": true,\n  \"subscriptionPrice\": 500,\n  \"currency\": \"KES\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/channels",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels"]
                },
                "description": "Create a paid channel. Users must pay to subscribe."
              }
            },
            {
              "name": "Get My Channel",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/me",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", "me"]
                },
                "description": "Get the authenticated user's channel"
              }
            },
            {
              "name": "Update Channel",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Updated Channel Name\",\n  \"description\": \"Updated description\",\n  \"isPaid\": true,\n  \"subscriptionPrice\": 1000,\n  \"currency\": \"KES\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/channels/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", ":id"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Update channel. Can change from free to paid or vice versa."
              }
            },
            {
              "name": "Delete Channel",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/channels/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["channels", ":id"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Delete channel (queued via VIDEO queue). Deletes all videos from MinIO/CDN."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Uploads & CDN",
      "description": "Video/image uploads to MinIO with automatic CDN sync to Cloudinary",
      "item": [
        {
          "name": "Upload Profile Picture",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/profile-pic",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "profile-pic"]
            },
            "description": "Upload profile picture (max 5MB, JPEG/PNG/WebP)"
          }
        },
        {
          "name": "Upload Video",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "My Video Title",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Video description",
                  "type": "text"
                },
                {
                  "key": "channelId",
                  "value": "channel-uuid-here",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/video",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "video"]
            },
            "description": "Upload video for HLS processing (max 500MB). Stored in MinIO, transcoded to HLS with adaptive bitrate (360p, 480p, 720p, 1080p)."
          }
        },
        {
          "name": "Upload Thumbnail",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "videoId",
                  "value": "video-uuid-here",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/thumbnail",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "thumbnail"]
            },
            "description": "Upload custom thumbnail for a video (max 5MB)"
          }
        },
        {
          "name": "Get Video URLs",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/videos/:videoId/urls",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "videos", ":videoId", "urls"],
              "variable": [
                {
                  "key": "videoId",
                  "value": "video-uuid-here"
                }
              ]
            },
            "description": "Get video URLs. Returns CDN URL if synced, MinIO fallback otherwise."
          }
        },
        {
          "name": "Delete Video",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/videos/:videoId",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "videos", ":videoId"],
              "variable": [
                {
                  "key": "videoId",
                  "value": "video-uuid-here"
                }
              ]
            },
            "description": "Delete video from MinIO (raw + HLS) and Cloudinary CDN"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "description": "Channel subscription management. Free channels allow direct subscription. Paid channels require M-Pesa payment first.",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "Get Subscriber Count",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/:channelId/count",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", ":channelId", "count"],
                  "variable": [
                    {
                      "key": "channelId",
                      "value": "channel-uuid-here"
                    }
                  ]
                }
              }
            },
            {
              "name": "Get Multiple Subscriber Counts",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channelIds\": [\"channel-uuid-1\", \"channel-uuid-2\"]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/counts",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", "counts"]
                }
              }
            },
            {
              "name": "Get Channel Subscribers",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/:channelId/subscribers?limit=50&cursor=",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", ":channelId", "subscribers"],
                  "query": [
                    { "key": "limit", "value": "50" },
                    { "key": "cursor", "value": "" }
                  ],
                  "variable": [
                    {
                      "key": "channelId",
                      "value": "channel-uuid-here"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Authenticated",
          "item": [
            {
              "name": "Subscribe to Channel (Free)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"endDate\": \"2025-12-31T23:59:59.000Z\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/:channelId/subscribe",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", ":channelId", "subscribe"],
                  "variable": [
                    {
                      "key": "channelId",
                      "value": "channel-uuid-here"
                    }
                  ]
                },
                "description": "Subscribe to a FREE channel. For PAID channels, returns 402 Payment Required with instructions to use /payments/subscribe-channel"
              }
            },
            {
              "name": "Unsubscribe from Channel",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/:channelId/subscribe",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", ":channelId", "subscribe"],
                  "variable": [
                    {
                      "key": "channelId",
                      "value": "channel-uuid-here"
                    }
                  ]
                }
              }
            },
            {
              "name": "Check Subscription Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/channels/:channelId/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "channels", ":channelId", "status"],
                  "variable": [
                    {
                      "key": "channelId",
                      "value": "channel-uuid-here"
                    }
                  ]
                }
              }
            },
            {
              "name": "Check Multiple Subscriptions",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channelIds\": [\"channel-uuid-1\", \"channel-uuid-2\"]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/check",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "check"]
                }
              }
            },
            {
              "name": "Get My Subscriptions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/me?page=1&limit=20&active=true",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "me"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "active", "value": "true" }
                  ]
                },
                "description": "Get user's subscriptions. Includes amountPaid for paid channel subscriptions."
              }
            },
            {
              "name": "Get Subscription by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", ":id"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "subscription-uuid-here"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Admin",
          "item": [
            {
              "name": "Get All Subscriptions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions?page=1&limit=50&status=ACTIVE",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "50" },
                    { "key": "status", "value": "ACTIVE" }
                  ]
                },
                "description": "Admin only - status: ACTIVE, CANCELLED, EXPIRED"
              }
            },
            {
              "name": "Get Subscription Stats",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/admin/stats",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "admin", "stats"]
                }
              }
            },
            {
              "name": "Get Top Channels",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/admin/top-channels?limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "admin", "top-channels"],
                  "query": [
                    { "key": "limit", "value": "10" }
                  ]
                }
              }
            },
            {
              "name": "Process Expired Subscriptions",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/admin/process-expired",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "admin", "process-expired"]
                }
              }
            },
            {
              "name": "Send Expiration Reminders",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/admin/send-reminders?days=7",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "admin", "send-reminders"],
                  "query": [
                    { "key": "days", "value": "7" }
                  ]
                }
              }
            },
            {
              "name": "Batch Subscribe Users",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"subscriptions\": [\n    {\"userId\": \"user-uuid-1\", \"channelId\": \"channel-uuid-1\", \"endDate\": \"2025-12-31T23:59:59.000Z\"},\n    {\"userId\": \"user-uuid-2\", \"channelId\": \"channel-uuid-1\"}\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/subscriptions/admin/batch",
                  "host": ["{{baseUrl}}"],
                  "path": ["subscriptions", "admin", "batch"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "User notifications. Write operations are processed asynchronously via RabbitMQ.",
      "item": [
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Get all notifications for the authenticated user (newest first)"
          }
        },
        {
          "name": "Get Unread Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread"]
            },
            "description": "Get only unread notifications"
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read-all"]
            },
            "description": "Mark all notifications as read (queued). Returns 202 Accepted."
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/:id/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", ":id", "read"],
              "variable": [
                {
                  "key": "id",
                  "value": "notification-uuid-here"
                }
              ]
            },
            "description": "Mark a single notification as read (queued). Returns 202 Accepted."
          }
        },
        {
          "name": "Delete Notification",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/:id",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "notification-uuid-here"
                }
              ]
            },
            "description": "Delete a notification (queued). Returns 202 Accepted."
          }
        }
      ]
    },
    {
      "name": "Payments (M-Pesa)",
      "description": "M-Pesa STK Push payments. Includes general payments and channel subscription payments.",
      "item": [
        {
          "name": "Initiate STK Push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"phoneNumber\": \"254712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "initiate"]
            },
            "description": "Initiates generic M-Pesa STK Push to user's phone"
          }
        },
        {
          "name": "Subscribe to Paid Channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"channel-uuid-here\",\n  \"phoneNumber\": \"254712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/subscribe-channel",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "subscribe-channel"]
            },
            "description": "Pay for a paid channel subscription via M-Pesa. Amount is fetched from channel's subscriptionPrice. After successful payment, subscription is automatically created."
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/history",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "history"]
            },
            "description": "Get user's payment and transaction history"
          }
        },
        {
          "name": "M-Pesa Callback (Webhook)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
